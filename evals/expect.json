{
  "clean": {
    "why": "A screen with nothing to cut comes back byte-identical, including the cases the counter used to flag.",
    "files": {
      "Members.tsx": { "unchanged": true }
    }
  },
  "real-state": {
    "why": "Decoration goes; a badge, a dot and numbering that reflect real state or real order stay.",
    "files": {
      "Deploys.tsx": {
        "keep": [
          "connection.status === \"online\"",
          "aria-label=\"Connected\"",
          "{deploy.isLive && <Badge>Live</Badge>}",
          "Install the CLI",
          "Log in",
          "Recent deploys",
          "deploys.map((deploy) =>"
        ],
        "keep_regex": ["0?1</span>\\s*Install", "0?3</span>\\s*Deploy"],
        "cut": ["uppercase tracking-widest", "🚀", ">NEW<", "This section lists", "refreshes automatically", "animate-pulse"],
        "no_new_numbers": true
      }
    }
  },
  "i18n": {
    "why": "Copy that lives in a translation file is fixed there, never hard-coded into the component.",
    "files": {
      "Billing.tsx": {
        "keep": ["t(\"billing.title\")", "t(\"billing.cta\")", "onClick={onUpgrade}", "useTranslation()"],
        "cut": ["uppercase tracking-widest"],
        "cut_regex": ["Upgrade plan", "subscription"]
      },
      "en.json": {
        "keep": ["\"title\": \"Billing\"", "Upgrade plan"],
        "cut": ["🚀", "Seamlessly", "all in one place"],
        "valid_json": true
      }
    }
  },
  "form": {
    "why": "Labels stay visible and tied to their inputs; the placeholder and helper text that repeat them go; a real constraint and an accessible name stay.",
    "files": {
      "signup.html": {
        "keep": [
          "<label for=\"email\">",
          "<label for=\"password\">",
          "id=\"email\"",
          "id=\"password\"",
          "At least 12 characters",
          "aria-label=\"Show password\"",
          "Create account"
        ],
        "cut": ["Enter your email address", "Enter your password", "We'll use this email address", "Fill out the form below", "✨"],
        "cut_regex": ["<input[^>]*aria-label"],
        "no_new_numbers": true
      }
    }
  },
  "claims": {
    "why": "Slogans go without inventing product facts; social proof the code cannot verify is reported, not deleted.",
    "files": {
      "index.html": {
        "keep": ["Trusted by 10,000+ teams", "Sarah Chen", "Start free trial", "Shared inbox", "Saved replies", "href=\"/signup\""],
        "cut": ["uppercase tracking-widest", "Reimagined", "next-generation", "effortlessly", "empowers"],
        "no_new_numbers": true
      }
    }
  }
}
